{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/prarabdha-soni/agent-sandbox/schemas/results-v0.1/results.schema.json",
  "title": "<world>/results.json (results-v0.1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["world", "version", "updated", "models"],
  "properties": {
    "world": {"type": "string"},
    "version": {"type": "string"},
    "updated": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "provider",
          "open_weight",
          "runs",
          "metrics",
          "by_category",
          "failures",
          "task_results"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "name": {"type": "string"},
          "provider": {"type": "string"},
          "open_weight": {"type": "boolean"},
          "runs": {"type": "integer", "minimum": 1},
          "metrics": {
            "type": "object",
            "additionalProperties": false,
            "required": ["public"],
            "properties": {
              "public": {"$ref": "#/$defs/metricGroup"},
              "hidden": {"$ref": "#/$defs/metricGroup"},
              "with_guard": {"$ref": "#/$defs/metricGroup"}
            }
          },
          "by_category": {"type": "object", "additionalProperties": {"type": "number"}},
          "failures": {
            "type": "object",
            "additionalProperties": {"type": "integer", "minimum": 0}
          },
          "task_results": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["task_id", "passed", "run_id"],
              "properties": {
                "task_id": {"type": "string"},
                "passed": {"type": "boolean"},
                "run_id": {"type": "string"}
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "metricGroup": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["value"],
        "properties": {"value": {"type": "number"}, "ci": {"type": "number", "minimum": 0}}
      }
    }
  }
}
